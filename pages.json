  "globalStyle": {
    "navigationBarTextStyle": "black", // "black" or "white"
    "navigationBarTitleText": "A-Share Stock Tool", // Default title for all pages if not overridden
    "navigationBarBackgroundColor": "#FFFFFF", // Default background color for navigation bar
    "backgroundColor": "#F8F9FA", // Default background color for window, pull-to-refresh
    "backgroundTextStyle": "dark", // "dark" or "light" for pull-to-refresh loading icon style
    "enablePullDownRefresh": false, // Disable global pull-down-refresh, can be enabled per page
    "rpxCalcMaxDeviceWidth": 960, // Default: 960, for rpx calculation
    "rpxCalcBaseDeviceWidth": 375 // Default: 375, for rpx calculation
